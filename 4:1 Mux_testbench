`timescale 1ns/1ps

module udp_mux_tb;
   reg s0, s1;
   reg i0,i1,i2,i3;
   wire f;
  
  udp_mux uut(
    f,
    s0,
    s1,
    i0,
    i1,
    i2,
    i3
  );
  
  initial 
    begin
      $dumpfile("upd_mux.vcd");
      $dumpvars(0,udp_mux_tb);
      
      //select i0
      s0=0; s1 =0;
      i0=0; i1=0; i2=0; i3=0;#10;
      i0=1;                  #10;
      
      
      //select i1
       s0=1; s1 =0;
      i1=0;                 #10;
      i1=1;                 #10;
      
      //select i2
       s0=0; s1 =1;
      i2=0;                #10;
      i2=1;                #10;
      
      
       //select i3
       s0=1; s1 =1;
       i3=0;              #10;
       i3=1;              #10;
       
      #10;
      $finish;
    end
  
  initial begin
    $monitor("Time=%0t s1=%b s0=%b i0=%b i1=%b i2=%b i3=%b -> f=%b",
              $time,s1,s0,i0,i1,i2,i3,f);
end

endmodule
      
      
  
